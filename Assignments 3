              where brewmaster.BrewerId = brewer.BrewerId
              order by brewmaster.Name";

        using var connection = DbHelper.GetConnection();
        List<Brewmaster> brewmasters = connection.Query<Brewmaster, Brewer, Brewmaster>(sql,
